2. Complete Java code
For easier interview preparation, all classes are placed in a single file named JobSchedulerDemo.java. This avoids package and multiple-file setup issues while preserving the responsibilities of the original design.

The implementation supports one-time scheduling, fixed-rate scheduling, fixed-delay scheduling, cancellation of pending jobs, concurrent execution, exception handling, and shutdown.

import java.util.UUID;
import java.util.Objects;
import java.util.concurrent.*;
import java.util.concurrent.atomic.AtomicBoolean;
import java.util.concurrent.locks.Condition;
import java.util.concurrent.locks.ReentrantLock;

// ================= TASK TYPE =================

enum TaskType {
    ONE_TIME,
    REPEAT_FIXED_RATE,
    REPEAT_FIXED_DELAY
}

// ================= SCHEDULING API =================

interface ISchedulerService {

    JobHandle schedule(
            Runnable task, long delay, TimeUnit unit);

    JobHandle scheduleAtFixedRate(
            Runnable task,
            long initialDelay,
            long period,
            TimeUnit unit);

    JobHandle scheduleWithFixedDelay(
            Runnable task,
            long initialDelay,
            long delay,
            TimeUnit unit);

    void shutdown();
}

// ================= JOB HANDLE =================

interface JobHandle {
    String getJobId();
    boolean cancel();
}

// ================= JOB =================

final class Job implements Comparable<Job> {

    private final String jobId;
    private final Runnable task;
    private final TaskType taskType;
    private final long periodNanos;

    // Next scheduled execution, measured using nanoTime().
    private volatile long nextRunNanos;

    private final AtomicBoolean cancelled =
            new AtomicBoolean(false);

    Job(
            String jobId,
            Runnable task,
            long nextRunNanos,
            long periodNanos,
            TaskType taskType) {

        this.jobId = jobId;
        this.task = task;
        this.nextRunNanos = nextRunNanos;
        this.periodNanos = periodNanos;
        this.taskType = taskType;
    }

    String getJobId() {
        return jobId;
    }

    Runnable getTask() {
        return task;
    }

    TaskType getTaskType() {
        return taskType;
    }

    long getPeriodNanos() {
        return periodNanos;
    }

    long getNextRunNanos() {
        return nextRunNanos;
    }

    void setNextRunNanos(long nextRunNanos) {
        this.nextRunNanos = nextRunNanos;
    }

    boolean isCancelled() {
        return cancelled.get();
    }

    boolean markCancelled() {
        return cancelled.compareAndSet(false, true);
    }

    @Override
    public int compareTo(Job other) {
        int result = Long.compare(
                this.nextRunNanos,
                other.nextRunNanos);

        if (result == 0) {
            return this.jobId.compareTo(other.jobId);
        }

        return result;
    }
}

// ================= SCHEDULER SERVICE =================

final class SchedulerService implements ISchedulerService {

    private static final SchedulerService INSTANCE =
            new SchedulerService(
                    Math.max(
                            1,
                            Runtime.getRuntime()
                                    .availableProcessors() - 1));

    private final PriorityQueue<Job> jobQueue =
            new PriorityQueue<>();

    private final ReentrantLock queueLock =
            new ReentrantLock();

    private final Condition queueChanged =
            queueLock.newCondition();

    private final ExecutorService workers;

    private final AtomicBoolean running =
            new AtomicBoolean(true);

    private final Thread schedulerThread;

    private SchedulerService(int workerCount) {
        workers = Executors.newFixedThreadPool(workerCount);

        schedulerThread = new Thread(
                new JobExecutor(),
                "job-scheduler");

        schedulerThread.start();
    }

    public static SchedulerService getInstance() {
        return INSTANCE;
    }

    // ---------- ONE-TIME SCHEDULING ----------

    @Override
    public JobHandle schedule(
            Runnable task,
            long delay,
            TimeUnit unit) {

        return addJob(
                task, delay, 0,
                unit, TaskType.ONE_TIME);
    }

    // ---------- FIXED-RATE SCHEDULING ----------

    @Override
    public JobHandle scheduleAtFixedRate(
            Runnable task,
            long initialDelay,
            long period,
            TimeUnit unit) {

        if (period <= 0) {
            throw new IllegalArgumentException(
                    "Period must be positive");
        }

        return addJob(
                task, initialDelay, period,
                unit, TaskType.REPEAT_FIXED_RATE);
    }

    // ---------- FIXED-DELAY SCHEDULING ----------

    @Override
    public JobHandle scheduleWithFixedDelay(
            Runnable task,
            long initialDelay,
            long delay,
            TimeUnit unit) {

        if (delay <= 0) {
            throw new IllegalArgumentException(
                    "Delay must be positive");
        }

        return addJob(
                task, initialDelay, delay,
                unit, TaskType.REPEAT_FIXED_DELAY);
    }

    // ---------- COMMON JOB CREATION ----------

    private JobHandle addJob(
            Runnable task,
            long initialDelay,
            long period,
            TimeUnit unit,
            TaskType type) {

        Objects.requireNonNull(task, "Task cannot be null");
        Objects.requireNonNull(unit, "TimeUnit cannot be null");

        if (initialDelay < 0) {
            throw new IllegalArgumentException(
                    "Initial delay cannot be negative");
        }

        long initialDelayNanos = unit.toNanos(initialDelay);
        long periodNanos = unit.toNanos(period);

        queueLock.lock();

        try {
            if (!running.get()) {
                throw new IllegalStateException(
                        "Scheduler has been shut down");
            }

            long deadline =
                    System.nanoTime() + initialDelayNanos;

            Job job = new Job(
                    UUID.randomUUID().toString(),
                    task,
                    deadline,
                    periodNanos,
                    type);

            jobQueue.offer(job);

            // Wake the scheduler to recheck the queue head.
            queueChanged.signalAll();

            return new ScheduledJobHandle(job);

        } finally {
            queueLock.unlock();
        }
    }

    // ---------- JOB CANCELLATION ----------

    private boolean cancelJob(Job job) {
        queueLock.lock();

        try {
            if (!job.markCancelled()) {
                return false;
            }

            jobQueue.remove(job);

            // The queue head may have changed.
            queueChanged.signalAll();

            return true;

        } finally {
            queueLock.unlock();
        }
    }

    private final class ScheduledJobHandle
            implements JobHandle {

        private final Job job;

        private ScheduledJobHandle(Job job) {
            this.job = job;
        }

        @Override
        public String getJobId() {
            return job.getJobId();
        }

        @Override
        public boolean cancel() {
            return cancelJob(job);
        }
    }

    // ---------- SCHEDULER THREAD ----------

    private final class JobExecutor implements Runnable {

        @Override
        public void run() {
            while (running.get()) {

                Job job = null;

                queueLock.lock();

                try {
                    while (running.get()) {

                        if (jobQueue.isEmpty()) {
                            queueChanged.await();
                            continue;
                        }

                        Job nextJob = jobQueue.peek();

                        long remainingNanos =
                                nextJob.getNextRunNanos()
                                - System.nanoTime();

                        if (remainingNanos > 0) {
                            // Sleep until the deadline or a signal.
                            queueChanged.awaitNanos(
                                    remainingNanos);
                            continue;
                        }

                        job = jobQueue.poll();
                        break;
                    }

                } catch (InterruptedException e) {
                    if (!running.get()) {
                        break;
                    }

                    // Recheck the queue if interrupted unexpectedly.
                    continue;

                } finally {
                    queueLock.unlock();
                }

                if (job == null) {
                    continue;
                }

                if (job.isCancelled()) {
                    continue;
                }

                try {
                    Job readyJob = job;

                    workers.execute(
                            () -> executeJob(readyJob));

                } catch (RejectedExecutionException e) {
                    if (running.get()) {
                        System.err.println(
                                "Worker pool rejected job: "
                                        + job.getJobId());
                    }
                }
            }
        }
    }

    // ---------- WORKER EXECUTION ----------

    private void executeJob(Job job) {

        if (job.isCancelled()) {
            return;
        }

        // Preserve the scheduled deadline before rescheduling.
        long previousDeadline = job.getNextRunNanos();

        try {
            job.getTask().run();

        } catch (Throwable error) {
            System.err.println(
                    "Job failed: " + job.getJobId());

            error.printStackTrace();

        } finally {
            rescheduleAfterExecution(job, previousDeadline);
        }
    }

    // ---------- RESCHEDULING ----------

    private void rescheduleAfterExecution(
            Job job,
            long previousDeadline) {

        if (job.getTaskType() == TaskType.ONE_TIME) {
            return;
        }

        queueLock.lock();

        try {
            if (!running.get() || job.isCancelled()) {
                return;
            }

            long nextDeadline;

            if (job.getTaskType()
                    == TaskType.REPEAT_FIXED_RATE) {

                // Measure from the previous scheduled time.
                nextDeadline =
                        previousDeadline + job.getPeriodNanos();

            } else {

                // Measure from the completion time.
                nextDeadline =
                        System.nanoTime() + job.getPeriodNanos();
            }

            job.setNextRunNanos(nextDeadline);
            jobQueue.offer(job);

            // Wake the scheduler if the next deadline changes.
            queueChanged.signalAll();

        } finally {
            queueLock.unlock();
        }
    }

    // ---------- SHUTDOWN ----------

    @Override
    public void shutdown() {

        queueLock.lock();

        try {
            if (!running.compareAndSet(true, false)) {
                return;
            }

            // Do not leave pending jobs in the queue.
            for (Job job : jobQueue) {
                job.markCancelled();
            }

            jobQueue.clear();
            queueChanged.signalAll();

        } finally {
            queueLock.unlock();
        }

        schedulerThread.interrupt();
        workers.shutdown();
    }
}

// ================= DEMO =================

public class JobSchedulerDemo {

    public static void main(String[] args)
            throws InterruptedException {

        ISchedulerService scheduler =
                SchedulerService.getInstance();

        // 1. One-time job: execute after 2 seconds.
        JobHandle oneTime = scheduler.schedule(
                () -> System.out.println(
                        "One-time job: "
                                + System.currentTimeMillis()),
                2,
                TimeUnit.SECONDS);

        // 2. Fixed-rate job: every 5 seconds.
        JobHandle fixedRate =
                scheduler.scheduleAtFixedRate(
                        () -> System.out.println(
                                "Fixed-rate job: "
                                        + System.currentTimeMillis()),
                        1,
                        5,
                        TimeUnit.SECONDS);

        // 3. Fixed-delay job: wait 5 seconds after completion.
        JobHandle fixedDelay =
                scheduler.scheduleWithFixedDelay(
                        () -> {
                            System.out.println(
                                    "Fixed-delay job started");

                            try {
                                TimeUnit.SECONDS.sleep(2);
                            } catch (InterruptedException e) {
                                Thread.currentThread().interrupt();
                                return;
                            }

                            System.out.println(
                                    "Fixed-delay job finished");
                        },
                        1,
                        5,
                        TimeUnit.SECONDS);

        System.out.println(
                "One-time Job ID: " + oneTime.getJobId());

        Thread.sleep(16000);

        // Optional cancellation before shutdown.
        fixedRate.cancel();
        fixedDelay.cancel();

        scheduler.shutdown();

        System.out.println("Scheduler shut down.");
    }
}



