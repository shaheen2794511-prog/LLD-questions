import java.util.HashMap;
import java.util.Map;

// ==================== EXCEPTIONS ====================

class NotFoundException extends RuntimeException {
    public NotFoundException(String message) {
        super(message);
    }
}

class StorageFullException extends RuntimeException {
    public StorageFullException(String message) {
        super(message);
    }
}

// ==================== STORAGE INTERFACE ====================

interface Storage<K, V> {
    void add(K key, V value);

    V get(K key);

    void remove(K key);
}

// ==================== HASHMAP STORAGE ====================

class HashMapBasedStorage<K, V> implements Storage<K, V> {

    private final Map<K, V> storage;
    private final int capacity;

    public HashMapBasedStorage(int capacity) {
        if (capacity <= 0) {
            throw new IllegalArgumentException(
                "Capacity must be positive"
            );
        }

        this.capacity = capacity;
        this.storage = new HashMap<>();
    }

    @Override
    public void add(K key, V value) {
        // Updating an existing key does not need extra capacity.
        if (!storage.containsKey(key)
                && storage.size() >= capacity) {
            throw new StorageFullException("Storage is full");
        }

        storage.put(key, value);
    }

    @Override
    public V get(K key) {
        if (!storage.containsKey(key)) {
            throw new NotFoundException("Key not found: " + key);
        }

        return storage.get(key);
    }

    @Override
    public void remove(K key) {
        if (!storage.containsKey(key)) {
            throw new NotFoundException("Key not found: " + key);
        }

        storage.remove(key);
    }

    public int size() {
        return storage.size();
    }
}

// ==================== EVICTION POLICY ====================

interface EvictionPolicy<K> {

    void keyAccessed(K key);

    K evictKey();
}

// ==================== DOUBLY LINKED LIST NODE ====================

class DoublyLinkedListNode<E> {
    E element;
    DoublyLinkedListNode<E> prev;
    DoublyLinkedListNode<E> next;

    public DoublyLinkedListNode(E element) {
        this.element = element;
    }
}

// ==================== DOUBLY LINKED LIST ====================

class DoublyLinkedList<E> {

    private DoublyLinkedListNode<E> first;
    private DoublyLinkedListNode<E> last;

    public DoublyLinkedList() {
        first = null;
        last = null;
    }

    // Add a node at the most-recently-used end.
    public DoublyLinkedListNode<E> addElementAtLast(E element) {
        DoublyLinkedListNode<E> node =
            new DoublyLinkedListNode<>(element);

        if (last == null) {
            first = last = node;
        } else {
            last.next = node;
            node.prev = last;
            last = node;
        }

        return node;
    }

    // Remove a node from any position.
    public void detachNode(DoublyLinkedListNode<E> node) {
        if (node == null) {
            return;
        }

        if (node == first) {
            first = node.next;

            if (first != null) {
                first.prev = null;
            }
        } else {
            node.prev.next = node.next;
        }

        if (node == last) {
            last = node.prev;

            if (last != null) {
                last.next = null;
            }
        } else {
            node.next.prev = node.prev;
        }

        // Disconnect the removed node.
        node.prev = null;
        node.next = null;
    }

    public DoublyLinkedListNode<E> getFirst() {
        return first;
    }

    public boolean isEmpty() {
        return first == null;
    }
}

// ==================== LRU EVICTION POLICY ====================

class LRUEvictionPolicy<K> implements EvictionPolicy<K> {

    private final DoublyLinkedList<K> dll;

    // Maps each key to its corresponding linked-list node.
    private final Map<K, DoublyLinkedListNode<K>> mapper;

    public LRUEvictionPolicy() {
        dll = new DoublyLinkedList<>();
        mapper = new HashMap<>();
    }

    @Override
    public void keyAccessed(K key) {

        // Key already exists: move it to the MRU end.
        if (mapper.containsKey(key)) {
            DoublyLinkedListNode<K> node = mapper.get(key);

            dll.detachNode(node);

            DoublyLinkedListNode<K> updatedNode =
                dll.addElementAtLast(key);

            mapper.put(key, updatedNode);
        } else {
            // New key: add it at the MRU end.
            DoublyLinkedListNode<K> newNode =
                dll.addElementAtLast(key);

            mapper.put(key, newNode);
        }
    }

    @Override
    public K evictKey() {

        // The first node represents the least recently used key.
        DoublyLinkedListNode<K> first = dll.getFirst();

        if (first == null) {
            return null;
        }

        K keyToEvict = first.element;

        dll.detachNode(first);
        mapper.remove(keyToEvict);

        return keyToEvict;
    }
}

// ==================== CACHE ====================

class Cache<K, V> {

    private final EvictionPolicy<K> evictionPolicy;
    private final Storage<K, V> storage;

    public Cache(
            EvictionPolicy<K> evictionPolicy,
            Storage<K, V> storage) {

        this.evictionPolicy = evictionPolicy;
        this.storage = storage;
    }

    public void put(K key, V value) {

        try {
            // First attempt to store the entry.
            storage.add(key, value);

            // Record the successful access.
            evictionPolicy.keyAccessed(key);

        } catch (StorageFullException exception) {

            // Find the key to evict.
            K keyToRemove = evictionPolicy.evictKey();

            if (keyToRemove == null) {
                throw new IllegalStateException(
                    "Storage is full but no key can be evicted"
                );
            }

            // Free space and retry the insertion.
            storage.remove(keyToRemove);
            storage.add(key, value);

            evictionPolicy.keyAccessed(key);
        }
    }

    public V get(K key) {

        try {
            V value = storage.get(key);

            // A successful read makes this key recently used.
            evictionPolicy.keyAccessed(key);

            return value;

        } catch (NotFoundException exception) {
            return null;
        }
    }
}

// ==================== MAIN ====================

public class CacheSystem {

    public static void main(String[] args) {

        Storage<String, String> storage =
            new HashMapBasedStorage<>(3);

        EvictionPolicy<String> policy =
            new LRUEvictionPolicy<>();

        Cache<String, String> cache =
            new Cache<>(policy, storage);

        cache.put("A", "Apple");
        cache.put("B", "Banana");
        cache.put("C", "Cherry");

        System.out.println(cache.get("A")); // Apple

        // Cache is full. B is now the least recently used.
        cache.put("D", "Dates");

        System.out.println(cache.get("B")); // null
        System.out.println(cache.get("C")); // Cherry
        System.out.println(cache.get("A")); // Apple
        System.out.println(cache.get("D")); // Dates
    }
}



