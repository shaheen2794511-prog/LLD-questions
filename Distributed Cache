// ==================== DOUBLY LINKED LIST ====================

class DoublyLinkedList<E> {

    private DoublyLinkedListNode<E> first;
    private DoublyLinkedListNode<E> last;

    public DoublyLinkedList() {
        first = null;
        last = null;
    }

    // Add a node at the most-recently-used end.
    public DoublyLinkedListNode<E> addElementAtLast(E element) {
        DoublyLinkedListNode<E> node =
            new DoublyLinkedListNode<>(element);

        if (last == null) {
            first = last = node;
        } else {
            last.next = node;
            node.prev = last;
            last = node;
        }

        return node;
    }

    // Remove a node from any position.
    public void detachNode(DoublyLinkedListNode<E> node) {
        if (node == null) {
            return;
        }

        if (node == first) {
            first = node.next;

            if (first != null) {
                first.prev = null;
            }
        } else {
            node.prev.next = node.next;
        }

        if (node == last) {
            last = node.prev;

            if (last != null) {
                last.next = null;
            }
        } else {
            node.next.prev = node.prev;
        }

        // Disconnect the removed node.
        node.prev = null;
        node.next = null;
    }

    public DoublyLinkedListNode<E> getFirst() {
        return first;
    }

    public boolean isEmpty() {
        return first == null;
    }
}

// ==================== LRU EVICTION POLICY ====================

class LRUEvictionPolicy<K> implements EvictionPolicy<K> {

    private final DoublyLinkedList<K> dll;

    // Maps each key to its corresponding linked-list node.
    private final Map<K, DoublyLinkedListNode<K>> mapper;

    public LRUEvictionPolicy() {
        dll = new DoublyLinkedList<>();
        mapper = new HashMap<>();
    }

    @Override
    public void keyAccessed(K key) {

        // Key already exists: move it to the MRU end.
        if (mapper.containsKey(key)) {
            DoublyLinkedListNode<K> node = mapper.get(key);

            dll.detachNode(node);

            DoublyLinkedListNode<K> updatedNode =
                dll.addElementAtLast(key);

            mapper.put(key, updatedNode);
        } else {
            // New key: add it at the MRU end.
            DoublyLinkedListNode<K> newNode =
                dll.addElementAtLast(key);

            mapper.put(key, newNode);
        }
    }

    @Override
    public K evictKey() {

        // The first node represents the least recently used key.
        DoublyLinkedListNode<K> first = dll.getFirst();

        if (first == null) {
            return null;
        }

        K keyToEvict = first.element;

        dll.detachNode(first);
        mapper.remove(keyToEvict);

        return keyToEvict;
    }
}

// ==================== CACHE ====================

class Cache<K, V> {

    private final EvictionPolicy<K> evictionPolicy;
    private final Storage<K, V> storage;

    public Cache(
            EvictionPolicy<K> evictionPolicy,
            Storage<K, V> storage) {

        this.evictionPolicy = evictionPolicy;
        this.storage = storage;
    }

    public void put(K key, V value) {

        try {
            // First attempt to store the entry.
            storage.add(key, value);

            // Record the successful access.
            evictionPolicy.keyAccessed(key);

        } catch (StorageFullException exception) {

            // Find the key to evict.
            K keyToRemove = evictionPolicy.evictKey();

            if (keyToRemove == null) {
                throw new IllegalStateException(
                    "Storage is full but no key can be evicted"
                );
            }

            // Free space and retry the insertion.
            storage.remove(keyToRemove);
            storage.add(key, value);

            evictionPolicy.keyAccessed(key);
        }
    }

    public V get(K key) {

        try {
            V value = storage.get(key);

            // A successful read makes this key recently used.
            evictionPolicy.keyAccessed(key);

            return value;

        } catch (NotFoundException exception) {
            return null;
        }
    }
}

