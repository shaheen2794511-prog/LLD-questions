2. Complete Java implementation
The following code combines the classes shown in your screenshots into a runnable implementation. It uses the same package structure conceptually, but places the classes in one Java file for easier practice. Save it as Application.java.

import java.io.Serializable;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

// ==================== OBSERVER INTERFACE ====================

interface LogObserver {
    void log(String message);
}

// ==================== OBSERVER IMPLEMENTATIONS ====================

class ConsoleLogger implements LogObserver {
    @Override
    public void log(String message) {
        System.out.println("Write to console: " + message);
    }
}

class FileLogger implements LogObserver {
    @Override
    public void log(String message) {
        System.out.println("Write to file: " + message);
        // A real implementation would write to a file.
    }
}

// ==================== OBSERVER SUBJECT ====================

class LogSubject {

    private final Map<Integer, List<LogObserver>> logObservers =
            new HashMap<>();

    public void addObserver(int level, LogObserver observer) {
        List<LogObserver> observers =
                logObservers.getOrDefault(level, new ArrayList<>());

        observers.add(observer);
        logObservers.put(level, observers);
    }

    public void notifyAllObserver(int level, String message) {
        List<LogObserver> observers = logObservers.get(level);

        if (observers != null) {
            for (LogObserver observer : observers) {
                observer.log(message);
            }
        }
    }
}

// ==================== CHAIN OF RESPONSIBILITY ====================

abstract class AbstractLogger {

    protected int level;
    protected AbstractLogger nextLoggingLevel;

    public void setNextLoggingLevel(AbstractLogger nextLogger) {
        this.nextLoggingLevel = nextLogger;
    }

    public void logMessage(
            int requestedLevel, String message, LogSubject logSubject) {

        if (requestedLevel == level) {
            display(message, logSubject);
        } else if (nextLoggingLevel != null) {
            nextLoggingLevel.logMessage(
                    requestedLevel, message, logSubject);
        } else {
            System.out.println("Unsupported log level: " + requestedLevel);
        }
    }

    protected abstract void display(
            String message, LogSubject logSubject);
}

// ==================== CONCRETE LOGGERS ====================

class InfoLogger extends AbstractLogger {

    public InfoLogger(int level) {
        this.level = level;
    }

    @Override
    protected void display(String message, LogSubject logSubject) {
        logSubject.notifyAllObserver(1, "INFO: " + message);
    }
}

class ErrorLogger extends AbstractLogger {

    public ErrorLogger(int level) {
        this.level = level;
    }

    @Override
    protected void display(String message, LogSubject logSubject) {
        logSubject.notifyAllObserver(2, "ERROR: " + message);
    }
}

class DebugLogger extends AbstractLogger {

    public DebugLogger(int level) {
        this.level = level;
    }

    @Override
    protected void display(String message, LogSubject logSubject) {
        logSubject.notifyAllObserver(3, "DEBUG: " + message);
    }
}

// ==================== LOG MANAGER ====================

class LogManager {

    protected static AbstractLogger buildChainOfLogger() {

        AbstractLogger infoLogger = new InfoLogger(1);
        AbstractLogger errorLogger = new ErrorLogger(2);
        AbstractLogger debugLogger = new DebugLogger(3);

        infoLogger.setNextLoggingLevel(errorLogger);
        errorLogger.setNextLoggingLevel(debugLogger);

        return infoLogger;
    }

    protected static LogSubject buildSubject() {

        LogSubject logSubject = new LogSubject();

        ConsoleLogger consoleLogger = new ConsoleLogger();
        FileLogger fileLogger = new FileLogger();

        logSubject.addObserver(1, consoleLogger);
        logSubject.addObserver(2, consoleLogger);
        logSubject.addObserver(3, consoleLogger);

        logSubject.addObserver(1, fileLogger);

        return logSubject;
    }
}

// ==================== SINGLETON LOGGER ====================

class Logger implements Serializable, Cloneable {

    private static volatile Logger logger;

    private final AbstractLogger chainOfLogger;
    private final LogSubject logSubject;

    private Logger() {
        chainOfLogger = LogManager.buildChainOfLogger();
        logSubject = LogManager.buildSubject();
    }

    public static Logger getInstance() {

        if (logger == null) {
            synchronized (Logger.class) {
                if (logger == null) {
                    logger = new Logger();
                }
            }
        }

        return logger;
    }

    public void info(String message) {
        chainOfLogger.logMessage(1, message, logSubject);
    }

    public void error(String message) {
        chainOfLogger.logMessage(2, message, logSubject);
    }

    public void debug(String message) {
        chainOfLogger.logMessage(3, message, logSubject);
    }

    @Override
    protected Object clone() throws CloneNotSupportedException {
        throw new CloneNotSupportedException(
                "Cloning Logger is not supported");
    }

    private Object readResolve() {
        return getInstance();
    }
}

// ==================== APPLICATION ====================

public class Application {

    public static void main(String[] args) {

        Logger logger = Logger.getInstance();

        logger.info("Application started");
        logger.error("Database connection failed");
        logger.debug("Entering the service method");
    }
}



