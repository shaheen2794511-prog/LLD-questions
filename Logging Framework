package SystemDesign.LoggingFrameworkDemo;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

public class LogSubject {

    private final Map<Integer, List<LogObserver>> logObservers =
            new HashMap<>();

    public void addObserver(int level, LogObserver logObserver) {
        List<LogObserver> observers =
                logObservers.getOrDefault(level, new ArrayList<>());

        observers.add(logObserver);
        logObservers.put(level, observers);
    }

    public void notifyAllObserver(int level, String msg) {
        for (Map.Entry<Integer, List<LogObserver>> entry
                : logObservers.entrySet()) {

            if (entry.getKey() == level) {
                entry.getValue().forEach(
                        observer -> observer.log(msg)
                );
            }
        }
    }
}



Explanation of LogSubject
1. Store observers by log level
Map<Integer, List<LogObserver>> logObservers = new HashMap<>();


This maps a level to a list of observers.

For example:
Level	Registered observers
1 — INFO	ConsoleLogger, FileLogger
2 — ERROR	ConsoleLogger, FileLogger
3 — DEBUG	ConsoleLogger

2. Register observers
addObserver(1, consoleLogger);
addObserver(1, fileLogger);


Both observers are registered for INFO messages.

getOrDefault() retrieves the existing list or creates a new list if that level has no observers yet. The observer is added to the list and the list is stored back in the map.

