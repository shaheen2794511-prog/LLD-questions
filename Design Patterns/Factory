interface Animal {

    void sound();
}
class Dog implements Animal {

    public void sound() {
        System.out.println("Dog barks");
    }
}
class AnimalFactory {

    public static Animal createAnimal(String type) {

        if (type.equals("dog")) {
            return new Dog();
        }

        if (type.equals("cat")) {
            return new Cat();
        }

        return null;
    }
}
