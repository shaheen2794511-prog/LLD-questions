// ================= CATALOG =================

class Catalog {
    private final Map<String, BookItem> copies =
            new LinkedHashMap<>();

    public void addBookItem(BookItem item) {
        if (copies.containsKey(item.getBarcode())) {
            throw new IllegalArgumentException(
                    "Duplicate book barcode");
        }
        copies.put(item.getBarcode(), item);
    }

    public void removeBookItem(String barcode) {
        BookItem item = findByBarcode(barcode);

        if (item == null) {
            throw new IllegalArgumentException(
                    "Book item not found");
        }

        if (item.getStatus() != BookStatus.AVAILABLE) {
            throw new IllegalStateException(
                    "Only available copies can be removed");
        }

        copies.remove(barcode);
    }

    public BookItem findByBarcode(String barcode) {
        return copies.get(barcode);
    }

    public List<BookItem> getAllCopies() {
        return new ArrayList<>(copies.values());
    }

    public List<BookItem> search(String query) {
        String q = query.toLowerCase(Locale.ROOT);
        List<BookItem> result = new ArrayList<>();

        for (BookItem item : copies.values()) {
            Book b = item.getBook();

            boolean matches =
                    b.getTitle().toLowerCase(Locale.ROOT)
                            .contains(q)
                    || b.getIsbn().toLowerCase(Locale.ROOT)
                            .contains(q)
                    || b.getSubject().toLowerCase(Locale.ROOT)
                            .contains(q)
                    || b.getAuthors().stream().anyMatch(
                            a -> a.toLowerCase(Locale.ROOT)
                                    .contains(q))
                    || b.getPublicationDate().toString()
                            .contains(q);

            if (matches) {
                result.add(item);
            }
        }

        return result;
    }
}

