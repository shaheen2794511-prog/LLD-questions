class DailyFineCalculator implements FineCalculator {
    private final double dailyRate;

    public DailyFineCalculator(double dailyRate) {
        if (dailyRate < 0) {
            throw new IllegalArgumentException(
                    "Invalid fine rate");
        }
        this.dailyRate = dailyRate;
    }

    @Override
    public double calculate(BookLoan loan, LocalDate date) {
        long days = ChronoUnit.DAYS.between(
                loan.getDueDate(), date);

        return Math.max(0, days) * dailyRate;
    }
