class LibraryService {
    private static final int MAX_LOAN_DAYS = 10;

    private final Catalog catalog;
    private final FineCalculator fineCalculator;
    private final NotificationService notifier;

    private final Map<String, Member> members = new HashMap<>();
    private final Map<String, BookLoan> loans = new HashMap<>();

    private final Map<String, Queue<Reservation>> reservations =
            new HashMap<>();

    private int nextId = 1;

    public LibraryService(Catalog catalog,
                          FineCalculator fineCalculator,
                          NotificationService notifier) {
        this.catalog = catalog;
        this.fineCalculator = fineCalculator;
        this.notifier = notifier;
    }

    public void registerMember(Member member) {
        if (members.putIfAbsent(member.getId(), member) != null) {
            throw new IllegalArgumentException(
                    "Member already registered");
        }

        for (Member existing : members.values()) {
            if (existing != member
                    && existing.getLibraryCardBarcode()
                    .equals(member.getLibraryCardBarcode())) {
                members.remove(member.getId());
                throw new IllegalArgumentException(
                        "Duplicate library card barcode");
            }
        }
    }

    // Barcode scanning identifies both member and copy.
    public void issueBook(String cardBarcode, String bookBarcode,
                          LocalDate issueDate, int loanDays) {
        Member member = members.values().stream()
                .filter(m -> m.getLibraryCardBarcode()
                        .equals(cardBarcode))
                .findFirst()
                .orElseThrow(() -> new IllegalArgumentException(
                        "Library card not found"));

        BookItem item = catalog.findByBarcode(bookBarcode);

        if (item == null) {
            throw new IllegalArgumentException(
                    "Book barcode not found");
        }

        if (item.getStatus() != BookStatus.AVAILABLE) {
            throw new IllegalStateException(
                    "Book is not available");
        }

        if (!member.canBorrow()) {
            throw new IllegalStateException(
                    "Maximum five active loans allowed");
        }

        if (loanDays <= 0 || loanDays > MAX_LOAN_DAYS) {
            throw new IllegalArgumentException(
                    "Loan period must be 1 to 10 days");
        }

        // Do not bypass the waiting queue.
        Queue<Reservation> queue =
                reservations.get(item.getBook().getIsbn());

        if (queue != null && queue.stream().anyMatch(
                r -> r.getStatus() == ReservationStatus.WAITING
                        || r.getStatus()
                        == ReservationStatus.READY_FOR_PICKUP)) {
            throw new IllegalStateException(
                    "A reservation has priority");
        }

        BookLoan loan = new BookLoan(
                "LOAN-" + nextId++,
                member, item, issueDate,
                issueDate.plusDays(loanDays));

        item.setStatus(BookStatus.ISSUED);
        member.addLoan(loan);
        loans.put(loan.getId(), loan);
    }

    public double returnBook(String loanId, LocalDate returnDate) {
        BookLoan loan = loans.get(loanId);

        if (loan == null || loan.getStatus() != LoanStatus.ACTIVE) {
            throw new IllegalStateException(
                    "Active loan not found");
        }

        double fine = fineCalculator.calculate(loan, returnDate);

        loan.markReturned(returnDate);

        BookItem item = loan.getBookItem();
        item.setStatus(BookStatus.AVAILABLE);

        notifier.send(loan.getMember().getEmail(),
                "Book returned: "
                        + item.getBook().getTitle()
                        + ". Fine: Rs. " + fine);

        makeNextReservationReady(item.getBook());

        return fine;
    }

    public void renewBook(String loanId, LocalDate today) {
        BookLoan loan = loans.get(loanId);

        if (loan == null || loan.getStatus() != LoanStatus.ACTIVE) {
            throw new IllegalStateException(
                    "Active loan not found");
        }

        if (today.isAfter(loan.getDueDate())) {
            throw new IllegalStateException(
                    "Overdue book cannot be renewed");
        }

        Queue<Reservation> queue =
                reservations.get(loan.getBookItem()
                        .getBook().getIsbn());

        if (queue != null && queue.stream().anyMatch(
                r -> r.getStatus() == ReservationStatus.WAITING
                        || r.getStatus()
                        == ReservationStatus.READY_FOR_PICKUP)) {
            throw new IllegalStateException(
                    "Book is reserved by another member");
        }

        loan.renew();

        notifier.send(loan.getMember().getEmail(),
                "Book renewed. New due date: "
                        + loan.getDueDate());
    }

    public Reservation reserveBook(String memberId, String isbn,
                                   LocalDate date) {
        Member member = members.get(memberId);

        if (member == null) {
            throw new IllegalArgumentException(
                    "Member not found");
        }

        Book book = catalog.getAllCopies().stream()
                .map(BookItem::getBook)
                .filter(b -> b.getIsbn().equals(isbn))
                .findFirst()
                .orElseThrow(() -> new IllegalArgumentException(
                        "Book not found"));

        boolean available = catalog.getAllCopies().stream()
                .anyMatch(i -> i.getBook().getIsbn().equals(isbn)
                        && i.getStatus() == BookStatus.AVAILABLE);

        if (available) {
            throw new IllegalStateException(
                    "Reserve only when no copy is available");
        }

        Reservation reservation = new Reservation(
                "RES-" + nextId++, member, book, date);

        reservations.computeIfAbsent(isbn,
                k -> new LinkedList<>()).offer(reservation);

        member.addReservation(reservation);

        return reservation;
    }

    private void makeNextReservationReady(Book book) {
        Queue<Reservation> queue =
                reservations.get(book.getIsbn());

        if (queue == null) {
            return;
        }

        boolean readyExists = queue.stream().anyMatch(
                r -> r.getStatus()
                        == ReservationStatus.READY_FOR_PICKUP);

        if (readyExists) {
            return;
        }

        Reservation next = queue.stream()
                .filter(r -> r.getStatus()
                        == ReservationStatus.WAITING)
                .findFirst()
                .orElse(null);

        if (next == null) {
            return;
        }

        BookItem availableCopy = catalog.getAllCopies().stream()
                .filter(i -> i.getBook().getIsbn()
                        .equals(book.getIsbn()))
                .filter(i -> i.getStatus()
                        == BookStatus.AVAILABLE)
                .findFirst()
                .orElse(null);

        if (availableCopy != null) {
            availableCopy.setStatus(BookStatus.RESERVED);
            next.setStatus(
                    ReservationStatus.READY_FOR_PICKUP);

            notifier.send(next.getMember().getEmail(),
                    "Your reserved book is ready: "
                            + book.getTitle());
        }
    }

    public void checkOverdueBooks(LocalDate today) {
        for (BookLoan loan : loans.values()) {
            if (loan.getStatus() == LoanStatus.ACTIVE
                    && today.isAfter(loan.getDueDate())) {
                notifier.send(loan.getMember().getEmail(),
                        "Overdue book: "
                                + loan.getBookItem().getBook()
                                .getTitle()
                                + ". Due date: "
                                + loan.getDueDate());
            }
        }
    }

    public List<BookLoan> getMemberLoans(String memberId) {
        Member member = members.get(memberId);

        if (member == null) {
            throw new IllegalArgumentException(
                    "Member not found");
        }

        return member.getLoans();
    }
}

